# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key that bypasses row level security. Use the secret key
# (sb_secret_...) or the legacy service_role key. Never expose it to the
# browser: do not prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Database password. Only the Supabase CLI uses it (db push); the app never
# reads it.
SUPABASE_DB_PASSWORD=

# Tavily search API key (https://app.tavily.com, free tier: 1,000 credits a
# month). Optional: without it, research runs use the free news-site search
# only. Each research uses 2-3 credits; repeated searches are cached.
TAVILY_API_KEY=

# Max research runs that can be created per rolling hour, across all
# visitors (cost guard for the public demo). Defaults to 20.
# RESEARCH_HOURLY_LIMIT=20

# AI analysis. Both have free tiers; configure at least one. Providers are
# tried in AI_PROVIDERS order and the next is used if one fails (rate limit,
# quota, timeout, bad output).
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides.
# AI_PROVIDERS=gemini,groq
# Gemini models, tried in order (free Flash models are often overloaded).
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
